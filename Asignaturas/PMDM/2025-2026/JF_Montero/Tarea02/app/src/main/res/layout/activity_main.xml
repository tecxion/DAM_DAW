<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/txt_Titulo"
        android:layout_width="324dp"
        android:layout_height="68dp"
        android:layout_marginTop="32dp"
        android:background="@color/clr_titulo"
        android:paddingTop="15dp"
        android:text="Calculadora VE"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtModelo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        android:layout_marginBottom="4dp"
        android:text="Seleccione Modelo:"
        app:layout_constraintBottom_toTopOf="@+id/spn_Modelo"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spn_Modelo"
        android:layout_width="247dp"
        android:layout_height="27dp"
        android:layout_marginTop="148dp"
        android:spinnerMode="dropdown"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.463"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/ptxt_Consumo"
        android:layout_width="245dp"
        android:layout_height="45dp"
        android:layout_marginTop="44dp"
        android:background="@color/gris"
        android:elevation="10dp"
        android:ems="10"
        android:inputType="text"
        android:paddingLeft="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.455"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spn_Modelo" />

    <TextView
        android:id="@+id/txt_Consumo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        android:text="Consumo del VE (kWh/100km)"
        app:layout_constraintBottom_toTopOf="@+id/ptxt_Consumo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spn_Modelo"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/txt_Precio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        android:layout_marginTop="24dp"
        android:text="Precio Electricidad (€/kWh)"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ptxt_Consumo" />

    <EditText
        android:id="@+id/ptxt_Precio"
        android:layout_width="245dp"
        android:layout_height="45dp"
        android:layout_marginStart="76dp"
        android:layout_marginTop="4dp"
        android:background="@color/gris"
        android:ems="10"
        android:inputType="text"
        android:paddingLeft="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_Precio" />

    <Button
        android:id="@+id/btn_calcular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Calcular"
        android:textStyle="bold"
        android:backgroundTint="@color/clr_titulo"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.489"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ptxt_Precio" />

    <TextView
        android:id="@+id/txt_Resultado"
        android:layout_width="298dp"
        android:layout_height="113dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_calcular" />

    <Button
        android:id="@+id/btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="112dp"
        android:backgroundTint="@color/b_reiniciar"
        android:elevation="10dp"
        android:text="Reiniciar"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_Resultado" />


</androidx.constraintlayout.widget.ConstraintLayout>